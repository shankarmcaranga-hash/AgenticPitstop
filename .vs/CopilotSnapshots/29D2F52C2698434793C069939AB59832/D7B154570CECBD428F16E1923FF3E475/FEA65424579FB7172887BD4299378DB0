@{
    var reports = new[]
    {
        ("Employee Utilization", "rpt.usp_EmployeeUtilization", "ClientPaged", true),
        ("Customer Aging", "rpt.usp_CustomerAging", "ServerPaged", false),
        ("Project Status", "rpt.usp_ProjectStatus", "ClientPaged", false)
    };
}

<div class="callout report-design-principle">
    <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
    <span><strong>Design principle:</strong> JavaScript builds the filters and result table dynamically. ASP.NET Core resolves the selected ReportId to an approved stored procedure on the server. Administrative metadata changes update the UI, but do not create SQL dynamically.</span>
</div>

<div class="report-config-layout">
    <aside class="card report-catalog">
        <div class="card-header">
            <div class="card-title-row">
                <h2 class="card-title">Report Catalog</h2>
                <button class="btn btn-primary btn-sm" id="registerReport"><i class="fa-solid fa-plus"></i>Register Report</button>
            </div>
            <p class="card-subtitle">Report definitions available to users.</p>
        </div>
        <div class="card-body">
            <div class="callout callout-info report-admin-note"><i class="fa-solid fa-lock"></i> This area is normally restricted to <strong>ReportAdmin</strong>.</div>
            <div class="report-list">
                @foreach (var report in reports)
                {
                    <button class="report-list-item @(report.Item4 ? "active" : "")" type="button" data-report="@report.Item1">
                        <strong>@report.Item1</strong>
                        <span>@report.Item2 · @report.Item3</span>
                    </button>
                }
            </div>
        </div>
    </aside>

    <div class="card report-metadata">
        <div class="card-header">
            <div class="card-title-row">
                <div>
                    <h2 class="card-title">Report Metadata — Employee Utilization</h2>
                    <p class="card-subtitle">The application stores this configuration in metadata tables.</p>
                </div>
                <span class="badge badge-warning">SP created separately</span>
            </div>
        </div>
        <div class="card-body">
            <div class="form-grid">
                <div class="form-group"><label for="reportName">Report name</label><input id="reportName" value="Employee Utilization" /></div>
                <div class="form-group"><label for="reportCode">Report code</label><input id="reportCode" value="EMP_UTIL" /></div>
                <div class="form-group full"><label for="reportDescription">Description</label><textarea id="reportDescription" rows="2">Employee utilization by region, department and date range.</textarea></div>
                <div class="form-group"><label for="procedureSchema">Procedure schema</label><input id="procedureSchema" value="rpt" /></div>
                <div class="form-group"><label for="procedureName">Procedure name</label><input id="procedureName" value="usp_EmployeeUtilization" /></div>
                <div class="form-group"><label for="executionMode">Execution mode</label><select id="executionMode"><option selected>ClientPaged</option><option>ServerPaged</option></select></div>
                <div class="form-group"><label for="pageSize">Default page size</label><input id="pageSize" type="number" value="10" /></div>
                <div class="form-group"><label for="maxRows">Max interactive rows</label><input id="maxRows" type="number" value="5000" /></div>
                <div class="form-group"><label for="timeout">Command timeout (seconds)</label><input id="timeout" type="number" value="120" /></div>
            </div>

            <div class="report-section">
                <div class="section-title-row"><h3>Parameters</h3><button class="btn btn-sm" id="addParameter"><i class="fa-solid fa-plus"></i>Add parameter</button></div>
                <div class="table-wrap compact-table"><table><thead><tr><th>Parameter</th><th>Display</th><th>SQL type</th><th>Control</th><th>Special values</th></tr></thead><tbody>
                    <tr><td><code>@@Region</code></td><td>Region</td><td>nvarchar</td><td><span class="badge badge-neutral">select</span></td><td>All N/A</td></tr>
                    <tr><td><code>@@Department</code></td><td>Department</td><td>nvarchar</td><td><span class="badge badge-neutral">select</span></td><td>All N/A</td></tr>
                    <tr><td><code>@@FromDate</code></td><td>From Date</td><td>date</td><td><span class="badge badge-neutral">date</span></td><td></td></tr>
                    <tr><td><code>@@ToDate</code></td><td>To Date</td><td>date</td><td><span class="badge badge-neutral">date</span></td><td></td></tr>
                </tbody></table></div>
            </div>

            <div class="report-section">
                <h3>Column Metadata</h3>
                <div class="table-wrap compact-table"><table><thead><tr><th>Source column</th><th>Display name</th><th>Format</th></tr></thead><tbody>
                    <tr><td>EmployeeId</td><td>Employee ID</td><td>default</td></tr><tr><td>EmployeeName</td><td>Employee Name</td><td>default</td></tr><tr><td>Region</td><td>Region</td><td>default</td></tr><tr><td>Department</td><td>Department</td><td>default</td></tr><tr><td>Utilization</td><td>Utilization %</td><td>0.0</td></tr>
                </tbody></table></div>
            </div>

            <div class="report-section">
                <h3>Permissions</h3>
                <div class="table-wrap compact-table"><table><thead><tr><th>Role</th><th>View</th><th>Execute</th><th>Export</th></tr></thead><tbody>
                    <tr><td>ReportUser</td><td>✓</td><td>✓</td><td>—</td></tr><tr><td>Manager</td><td>✓</td><td>✓</td><td>✓</td></tr><tr><td>Finance</td><td>—</td><td>—</td><td>—</td></tr><tr><td>ReportAdmin</td><td>✓</td><td>✓</td><td>✓</td></tr>
                </tbody></table></div>
            </div>

            <div class="form-actions report-actions"><button class="btn btn-primary" id="saveReportMetadata"><i class="fa-solid fa-floppy-disk"></i>Save Metadata</button><button class="btn" id="validateReport"><i class="fa-solid fa-check"></i>Validate Configuration</button></div>
            <p class="input-help">Production recommendation: validation should confirm the stored procedure exists, allowed parameters match metadata, permissions are valid, and the report can execute under the application’s least-privilege SQL identity.</p>
        </div>
    </div>
</div>

<script nonce="@Context.ApsNonce()">
(window.apsReady = window.apsReady || []).push(function ($) {
    $('.report-list-item').on('click', function () {
        $('.report-list-item').removeClass('active');
        $(this).addClass('active');
        $('.report-metadata .card-title').first().text('Report Metadata — ' + $(this).data('report'));
    });
    $('#saveReportMetadata').on('click', function () { APS.toast('Report metadata saved in this prototype.', 'success'); });
    $('#validateReport').on('click', function () { APS.toast('Configuration validation completed successfully.', 'success'); });
    $('#registerReport, #addParameter').on('click', function () { APS.toast('This control is ready for the report definition workflow.', 'info'); });
});
</script>
