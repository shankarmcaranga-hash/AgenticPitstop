    [HttpPost]
    public IActionResult SaveCollection(short cid, string collectionname, string description,
                                        string fieldsJson)
    {
        if (string.IsNullOrWhiteSpace(collectionname))
            return Fail("Collection name is required.");

        if (!IsValidCollectionName(collectionname))
            return Fail("Collection name must start with a letter and contain letters and numbers only — no spaces or special characters.");

        var fields = ApsDb.NewColumnList();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        short order = 0;

        foreach (var element in ParseArray(fieldsJson))
        {
            var name = ReadString(element, "name");
            if (string.IsNullOrWhiteSpace(name)) continue;

            name = name.Trim();
            if (!IsValidIdentifier(name))
                return Fail($"Field name '{name}' must start with a letter and contain only letters, numbers or underscore.");

            if (!seen.Add(name))
                return Fail($"Field '{name}' is listed more than once.");

            var dataType = ReadString(element, "dataType");
            var inputType = ReadString(element, "inputType");

            if (string.Equals(inputType, "Checkbox", StringComparison.OrdinalIgnoreCase) &&
                !string.Equals(dataType, "Number", StringComparison.OrdinalIgnoreCase))
                return Fail($"Field '{name}' uses a Checkbox input, which stores 0 or 1 and needs the Number data type.");

            fields.Rows.Add(name,
                            string.IsNullOrWhiteSpace(dataType) ? "Text" : dataType,
                            string.IsNullOrWhiteSpace(inputType) ? "Textbox" : inputType,
                            ++order);
        }

        if (fields.Rows.Count == 0)
            return Fail("Add at least one field to the collection.");

        var outputs = Db.ExecuteWithOutput("APS_Collection_Save", p =>
        {
            ApsDb.In(p, "@cid", cid);
            ApsDb.In(p, "@collectionname", collectionname.Trim());
            ApsDb.In(p, "@description", description?.Trim());
            ApsDb.Table(p, "@fields", "dbo.APS_ColumnListType", fields);
            ApsDb.In(p, "@actionby", ActionBy);
            ApsDb.Out(p, "@newcid", SqlDbType.SmallInt);
            ApsDb.Out(p, "@message", SqlDbType.NVarChar, 400);
        });

        return FromProcedure(outputs, "newcid");
    }

