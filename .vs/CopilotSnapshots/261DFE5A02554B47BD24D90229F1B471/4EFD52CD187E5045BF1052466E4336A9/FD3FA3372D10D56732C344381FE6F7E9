@{
    var questions = ViewBag.ChecklistQuestions as DataTable ?? new DataTable();
    var sources = ViewBag.SourceRegistry as DataTable ?? new DataTable();
}
<div class="card checklist-screen">
    <div class="card-header"><div class="card-title-row"><div><span class="eyebrow">MASTER 02</span><h2 class="card-title screen-title">Checklist Master</h2><p class="card-subtitle">Create reusable checklist questions and define which source(s) are applicable to each question.</p></div><div class="page-actions"><button class="btn" type="button">Manage Categories</button><button class="btn btn-primary" id="addQuestion"><i class="fa-solid fa-plus"></i>Add Question</button></div></div></div><div class="card-body">
        <div class="report-info source-stats"><div><span>Total questions</span><strong>@questions.Rows.Count</strong><small>Configured in checklist master</small></div><div><span>Multi-source questions</span><strong>0</strong><small>Need evidence from 2+ sources</small></div><div><span>Categories</span><strong>7</strong><small>Business grouping / applicability</small></div></div><div class="section-title-row" style="margin-top:22px"><div><h3 class="card-title">Checklist Questions</h3><p class="card-subtitle">Instruction prompt tells the agent what to evaluate. Business rules prompt defines PASS/FAIL/N/A or other decision rules.</p></div></div><div class="toolbar"><input id="questionSearch" type="search" placeholder="Search question, category, source..." /><select><option>All categories</option></select><select><option>All statuses</option></select></div><div class="table-wrap">
            <table>
                <thead><tr><th>#</th><th>Question / Category</th><th>Source Applicability</th><th>Instruction Prompt</th><th>Business Rules Prompt</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (DataRow question in questions.Rows)
                    {
                        <tr><td>@ApsMetadata.Cell(question, "questionid")</td><td><strong>@ApsMetadata.Cell(question, "question")</strong><small>@ApsMetadata.Cell(question, "category")</small></td><td>@ApsMetadata.Cell(question, "sources")</td><td>@ApsMetadata.Cell(question, "instructionprompt")</td><td>@ApsMetadata.Cell(question, "businessrulesprompt")</td><td><span class="badge badge-success">Active</span></td><td><button type="button" class="btn btn-sm edit-question">Edit</button><button type="button" class="btn btn-sm btn-danger delete-question">Delete</button></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div id="questionModal" class="modal" hidden>
    <div class="modal-card">
        <div class="card-header">
            <div class="card-title-row">
                <h2 class="card-title">Add Checklist Question</h2>
                <button type="button" class="btn btn-sm close-question">×</button>
            </div>
        </div>
        <div class="card-body">
            <input id="questionId" type="hidden" />
            <div class="form-grid">
                <div class="form-group full">
                    <label for="questionText">Question</label>
                    <textarea id="questionText"></textarea>
                </div>
                <div class="form-group">
                    <label for="questionCategory">Category</label>
                    <select id="questionCategory" class="form-control">
                        <option value="Product">Product</option>
                        <option value="Eligibility">Eligibility</option>
                        <option value="Identity">Identity</option>
                        <option value="Documentation">Documentation</option>
                        <option value="Financial">Financial</option>
                        <option value="Compilance">Compilance</option>
                        <option value="Operational Control">Operational Control</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="questionStatus">Status</label>
                    <select id="questionStatus" class="form-control">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>

                <div class="form-group full">
                    <label class="field-label">
                        Source Applicability <span class="required">*</span>
                    </label>
                    <div class="source-dropdown-container">
                        <div class="source-dropdown-header">
                            Select one or more sources
                            <span class="dropdown-arrow">⌄</span>
                        </div>

                        <div class="source-list">
                            @foreach (DataRow source in sources.Rows)
                            {
                                if (!Convert.ToBoolean(source["status"])) { continue; }
                                var sourceId = ApsMetadata.Cell(source, "sourcecode");
                                <div class="source-item">
                                    <input type="checkbox" class="question-source" id="source_@sourceId" value="@sourceId" />
                                    <label for="source_@sourceId"><div class="source-title">@ApsMetadata.Cell(source, "sourcename")</div><div class="source-subtitle">@ApsMetadata.Cell(source, "sourcetype") · @sourceId</div></label>
                                </div>
                            }
                        </div>
                    </div>
                </div>


                <div class="form-group full">
                    <label for="instructionPrompt">Instruction Prompt</label>
                    <textarea id="instructionPrompt"></textarea>
                </div>
                <div class="form-group full">
                    <label for="businessRulesPrompt">Business Rules Prompt</label>
                    <textarea id="businessRulesPrompt"></textarea>
                </div>
                <div class="form-group">
                    <label for="questionOutputType">Output Type</label>
                    <select id="questionOutputType" class="form-control">
                        <option value="1">PASS / FAIL / Not Applicable</option>
                        <option value="2">Yes / No /UnKnown</option>
                        <option value="3">Text Explanation</option>
                        <option value="4">Structured JSON</option>
                        <option value="5">Source / Rating</option>
                        <option value="6">Custom</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="displayOrder">Display Order</label>
                    <input type="number"
                           id="displayOrder"
                           min="0"
                           step="1"
                           value="0"
                           class="form-control">
                </div>
                <div class="form-group full">
                    <label for="questionnotes">Developer Notes</label>
                    <textarea id="questionnotes" placeholder="Source codes separated by comma"></textarea>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn close-question" type="button">Cancel</button>
                <button class="btn btn-primary" id="saveQuestion" type="button">Save Question</button>
            </div>
        </div>
    </div>
    <style>
        .source-dropdown-container {
            position: relative;
            width: 100%;
        }

        .source-dropdown-header {
            border: 1px solid #d6dbe5;
            border-radius: 12px;
            padding: 15px 18px;
            background: #fff;
            cursor: pointer;
            position: relative;
            font-size: 16px;
        }

        .dropdown-arrow {
            position: absolute;
            right: 16px;
            top: 16px;
            transition: transform .3s;
        }

            .dropdown-arrow.rotate {
                transform: rotate(180deg);
            }

        .source-list {
            display: none;
            margin-top: 8px;
            border: 1px solid #d6dbe5;
            border-radius: 12px;
            background: #fff;
            max-height: 350px;
            overflow-y: auto;
        }

            .source-list.show {
                display: block;
            }

        .source-item {
            display: flex;
            gap: 10px;
            padding: 18px;
        }

            .source-item:hover {
                background: #f6f8fb;
            }

            .source-item input[type="checkbox"] {
                width: 18px;
                height: 18px;
                margin-top: 4px;
            }

        .source-title {
            font-size: 18px;
            font-weight: 600;
            color: #44536d;
        }

        .source-subtitle {
            font-size: 14px;
            color: #66748d;
        }
    </style>
    <script nonce="@Context.ApsNonce()">(window.apsReady = window.apsReady || []).push(function ($) {
    function close() { $('#questionModal').attr('hidden', 'hidden'); }
    function show(mode, row) {
        $('#questionModal').removeAttr('hidden');
        $('#questionModal .card-title').text(mode === 'edit' ? 'Edit Checklist Question' : 'Add Checklist Question');
        $('#questionId').val(row ? row.find('td').eq(0).text().trim() : 0);
        $('#questionText').val(row ? row.find('td').eq(1).find('strong').text() : '');
        $('#questionCategory').val(row ? row.find('td').eq(1).find('small').text() : 'Product');
        $('#instructionPrompt').val(row ? row.find('td').eq(3).text() : '');
        $('#businessRulesPrompt').val(row ? row.find('td').eq(4).text() : '');
        $('.question-source').prop('checked', false);
        if (row) { var selected = row.find('td').eq(2).text().split(',').map(function (v) { return v.trim(); }); $('.question-source').each(function () { $(this).prop('checked', selected.indexOf($(this).val()) >= 0); }); }
        $('#questionText').trigger('focus');
    }
    $('.source-dropdown-header').on('click', function () { $('.source-list').toggleClass('show'); $('.dropdown-arrow').toggleClass('rotate'); });
    $(document).on('click', '#addQuestion', function (e) { e.preventDefault(); show('add'); });
    $(document).on('click', '.close-question', close);
    $(document).on('click', '.edit-question', function () { show('edit', $(this).closest('tr')); });
    $('#saveQuestion').on('click', function () { var selectedSources = $('.question-source:checked').map(function () { return this.value; }).get(); APS.post('@Url.Action("SaveChecklistQuestion", "Configuration")', { questionid: $('#questionId').val(), category: $('#questionCategory').val(), question: $('#questionText').val(), instructionprompt: $('#instructionPrompt').val(), businessrulesprompt: $('#businessRulesPrompt').val(), sourcesJson: JSON.stringify(selectedSources), activestatus: $('#questionStatus').val() === 'Active' }).then(function (r) { if (r.success) window.location.reload(); }); });
    $(document).on('click', '.delete-question', function () { if (!confirm('Deactivate this question?')) return; APS.post('@Url.Action("DeleteChecklistQuestion", "Configuration")', { questionid: $(this).closest('tr').find('td').eq(0).text() }).then(function (r) { if (r.success) window.location.reload(); }); });
    $('#questionSearch').on('input', function () { var q = $(this).val().toLowerCase(); $('.checklist-screen table tbody tr').each(function () { $(this).toggle($(this).text().toLowerCase().indexOf(q) >= 0); }); });
});</script>
