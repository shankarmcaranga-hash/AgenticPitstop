@{
    var sources = ViewBag.SourceRegistry as DataTable ?? new DataTable();
}
<div class="card source-registry-screen">
    <div class="card-header"><div class="card-title-row"><div><span class="eyebrow">MASTER 01</span><h2 class="card-title screen-title">Source Registry</h2><p class="card-subtitle">Define the systems, repositories, agents, files, and user inputs that can supply evidence to checklist questions.</p></div><div class="page-actions"><button class="btn" type="button">Export Config</button><button class="btn" type="button">Import Config</button><button class="btn btn-primary" id="addSource"><i class="fa-solid fa-plus"></i>Add Source</button></div></div></div>
    <div class="card-body">
        <div class="report-info source-stats"><div><span>Total sources</span><strong>@sources.Rows.Count</strong><small>Reusable across checklist masters</small></div><div><span>Active sources</span><strong>@(sources.Rows.Cast<DataRow>().Count(r => Convert.ToBoolean(r["status"])))</strong><small>Available for question applicability</small></div><div><span>Used by checklist</span><strong>0</strong><small>Referenced by one or more questions</small></div></div>
        <div class="section-title-row" style="margin-top:22px"><div><h3 class="card-title">Registered Sources</h3><p class="card-subtitle">Examples: Core application API, document repository, vision agent, database, uploaded file, manual input.</p></div></div>
        <div class="toolbar"><input id="sourceSearch" type="search" placeholder="Search source name, code, type..." /><select id="sourceType"><option value="">All types</option><option>Application API</option><option>Document Repository</option><option>Vision / Document AI</option><option>Manual / User Input</option></select><select id="sourceStatus"><option value="">All statuses</option><option value="1">Active</option><option value="0">Inactive</option></select></div>
        <div class="table-wrap">
            <table id="sourceTable">
                <thead><tr><th>Source</th><th>Type</th><th>Access / Interface</th><th>Owner</th><th>Status</th><th>Used by</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (DataRow source in sources.Rows)
                    {
                        <tr data-source-id="@ApsMetadata.Cell(source, "sourceid")" data-search="@ApsMetadata.Cell(source, "sourcename") @ApsMetadata.Cell(source, "sourcecode") @ApsMetadata.Cell(source, "sourcetype")" data-type="@ApsMetadata.Cell(source, "sourcetype")" data-status="@ApsMetadata.Cell(source, "status")"><td><strong>@ApsMetadata.Cell(source, "sourcename")</strong><small>@ApsMetadata.Cell(source, "sourcecode")</small></td><td>@ApsMetadata.Cell(source, "sourcetype")</td><td>@ApsMetadata.Cell(source, "accessinterface")</td><td>@ApsMetadata.Cell(source, "owner")</td><td><span class="badge @(Convert.ToBoolean(source["status"]) ? "badge-success" : "badge-danger")">@(Convert.ToBoolean(source["status"]) ? "Active" : "Inactive")</span></td><td>0 questions</td><td><button type="button" class="btn btn-sm edit-source">Edit</button><button type="button" class="btn btn-sm btn-danger delete-source">Delete</button></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div id="sourceModal" class="modal" hidden>
    <div class="modal-card">
        <div class="card-header">
            <div class="card-title-row">
                <h2 class="card-title">Add Source</h2>
                <button type="button" class="btn btn-sm close-source">×</button>
            </div>
        </div>
        <div class="card-body">
            <input id="sourceId" type="hidden" />
            <div class="form-grid">
                <div class="form-group">
                    <label>Source Name</label>
                    <input id="sourceName" />
                </div>
                <div class="form-group">
                    <label>Source Code</label>
                    <input id="sourceCode" />
                </div>
                <div class="form-group">
                    <label for="sourceTypeValue">Source Type</label>
                    <select id="sourceTypeValue" class="form-control">
                        <option value="Application API">Application API</option>
                        <option value="Database">Database</option>
                        <option value="Document Repository">Document Repository</option>
                        <option value="Vision / Dcument API">Vision / Dcument API</option>
                        <option value="LLM / Agent">LLM / Agent</option>
                        <option value="Uploaded File">Uploaded File</option>
                        <option value="Manual / User Input">Manual / User Input</option>
                        <option value="External Service">External Service</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Access / Interface</label>
                    <input id="sourceAccess" />
                </div>
                <div class="form-group">
                    <label>Owner / Team</label>
                    <input id="sourceOwner" />
                </div>
                <div class="form-group">
                    <label for="sourcesStatus">Status</label>
                    <select id="sourcesStatus" class="form-control">
                        <option value="True">Active</option>
                        <option value="False">Inactive</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="sourceDataClassification">Data Classification</label>
                    <select id="sourceDataClassification" class="form-control">
                        <option value="1">Internal</option>
                        <option value="2">Confidential</option>
                        <option value="3">Restricted / Sensitive</option>
                        <option value="4">Public</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Authentication / Connection</label>
                    <input id="sourceAuthentication"></input>
                </div>
                <div class="form-group full">
                    <label>Description</label>
                    <textarea id="sourceDescription"></textarea>
                </div>
                <div class="form-group full">
                    <label>Developer Notes / Configuration</label>
                    <textarea id="sourcedeveloperNotes"></textarea>
                </div>
            </div><div class="form-actions"><button class="btn" type="button" id="cancelSource">Cancel</button><button class="btn btn-primary" type="button" id="saveSource">Save Source</button></div>
        </div>
    </div>
</div>
<script nonce="@Context.ApsNonce()">(window.apsReady = window.apsReady || []).push(function ($) { function open(row) { $('#sourceModal').prop('hidden', false); $('.modal-card .card-title').text(row ? 'Edit Source' : 'Add Source'); $('#sourceId').val(row ? row.data('source-id') : 0); $('#sourceName').val(row ? row.find('strong').text() : ''); $('#sourceCode').val(row ? row.find('small').text() : ''); $('#sourceTypeValue').val(row ? row.find('td').eq(1).text() : ''); $('#sourceAccess').val(row ? row.find('td').eq(2).text() : ''); $('#sourceOwner').val(row ? row.find('td').eq(3).text() : '');  } function close() { $('#sourceModal').prop('hidden', true); } $('#addSource').on('click', function () { open(); }); $('.edit-source').on('click', function () { open($(this).closest('tr')); }); $('#cancelSource,.close-source').on('click', close); $('#saveSource').on('click', function () { APS.post('@Url.Action("SaveSourceRegistry", "Configuration")', { sourceid: $('#sourceId').val(), sourcename: $('#sourceName').val(), sourcecode: $('#sourceCode').val(), sourcetype: $('#sourceTypeValue').val(), accessinterface: $('#sourceAccess').val(), owner: $('#sourceOwner').val(),dataclassification: $('#sourceDataClassification').val(), authenticationconnection: $('#sourceAuthentication').val(), description: $('#sourceDescription').val(), sourcedeveloperNotes: $('#sourcedeveloperNotes').val()  }).then(function (r) { if (r.success) window.location.reload(); }); }); $('.delete-source').on('click', function () { if (!confirm('Deactivate this source?')) return; APS.post('@Url.Action("DeleteSourceRegistry", "Configuration")', { sourceid: $(this).closest('tr').data('source-id') }).then(function (r) { if (r.success) window.location.reload(); }); }); $('#sourceSearch,#sourceType,#sourceStatus').on('input change', function () { var q = $('#sourceSearch').val().toLowerCase(), type = $('#sourceType').val(), status = $('#sourceStatus').val(); $('#sourceTable tbody tr').each(function () { $(this).toggle((!q || $(this).data('search').toLowerCase().indexOf(q) >= 0) && (!type || $(this).data('type') == type) && (!status || String($(this).data('status')) == status)); }); }); });</script>
